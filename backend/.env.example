# ===============================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ===============================================

PROJECT_NAME="Premium Land Discovery API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Production Secret Key (Change this in production)
SECRET_KEY="nilam-prime-super-secret-jwt-key-2026-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Supabase PostgreSQL async or fallback SQLite)
# For Supabase: postgresql+asyncpg://postgres.[YOUR-PROJECT]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL="sqlite+aiosqlite:///./realestate.db"

# Cloudinary Storage for 4K Drone Footage and Aerial Photography
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Two Authorized Administrator Accounts
ADMIN_1_EMAIL="broker@nilamprime.com"
ADMIN_1_PASSWORD="BrokerPrime@2026"

ADMIN_2_EMAIL="gokulravi.hhc@gmail.com"
ADMIN_2_PASSWORD="Gokul@123"
